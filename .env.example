# ---------------------------------------------------------------------------
# Komen (Kos Manajemen) — contoh konfigurasi
# Salin menjadi `.env` untuk pengembangan lokal.
# Di Vercel, isi nilai-nilai ini di Settings → Environment Variables.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# DATABASE (Turso / libSQL)
#
# Di Vercel: WAJIB diisi. Buat database gratis di https://turso.tech
# (tanpa kartu kredit), lalu ambil URL dan tokennya.
#
#   TURSO_DATABASE_URL=libsql://nama-db-anda.turso.io
#   TURSO_AUTH_TOKEN=eyJhbGciOi...
#
# Bila dikosongkan, aplikasi memakai berkas SQLite lokal (DB_PATH) —
# inilah yang dipakai saat `npm start` dan saat menjalankan pengujian.
# ---------------------------------------------------------------------------
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Lokasi berkas SQLite untuk mode lokal (diabaikan bila memakai Turso)
DB_PATH=data/komen.db

# Server lokal (Vercel mengatur PORT sendiri)
PORT=3000
NODE_ENV=development

# Identitas kos (dipakai di header, notifikasi, dan pesan WhatsApp)
KOST_NAME=Kos Melati Residence
KOST_ADDRESS=Jl. Melati No. 12, Yogyakarta
KOST_LAT=-7.782900
KOST_LNG=110.367000

# Masa aktif sesi login (hari)
SESSION_TTL_DAYS=7

# Batas ukuran gambar yang diterima server (byte).
# Browser sudah mengecilkan gambar sebelum mengunggah, jadi 1,5 MB lega.
MAX_IMAGE_BYTES=1500000

# ---------------------------------------------------------------------------
# WhatsApp Gateway
# WA_PROVIDER = mock | fonnte | meta
#   mock   -> tidak mengirim ke internet, pesan hanya dicatat di tabel wa_logs
#   fonnte -> https://fonnte.com  (WA_TOKEN = token device)
#   meta   -> WhatsApp Cloud API  (WA_TOKEN = access token, WA_PHONE_ID = phone number id)
# ---------------------------------------------------------------------------
WA_PROVIDER=mock
WA_TOKEN=
WA_PHONE_ID=
WA_TEMPLATE_LANG=id

# ---------------------------------------------------------------------------
# Payment Gateway (QRIS & Virtual Account)
# PAYMENT_PROVIDER = mock | custom
#   mock   -> QRIS/VA dibuat lokal, status dikonfirmasi lewat tombol simulasi
#             di UI atau webhook. Cocok untuk demo.
#   custom -> kirim request pembuatan transaksi ke PAYMENT_API_URL
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
PAYMENT_API_URL=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=komen-dev-webhook-secret
PAYMENT_EXPIRY_MINUTES=60
PAYMENT_MERCHANT_NAME=KOS MELATI RESIDENCE
PAYMENT_MERCHANT_CITY=YOGYAKARTA
PAYMENT_MERCHANT_ID=ID1024336612345

# ---------------------------------------------------------------------------
# Vercel Cron
# Diisi otomatis oleh Vercel bila Anda menambahkannya; dipakai untuk
# mengamankan endpoint /api/cron/tick. Boleh dikosongkan.
# ---------------------------------------------------------------------------
CRON_SECRET=
